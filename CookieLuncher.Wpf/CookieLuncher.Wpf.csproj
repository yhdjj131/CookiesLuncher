<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CookieLuncher</RootNamespace>
    <AssemblyName>CookieLuncher.Wpf</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>Cookie 启动器</AssemblyTitle>
    <Product>Cookie 启动器（WPF 桌面版）</Product>
    <Description>本地 Cookie 加密启动器 —— WPF 窗口界面，数据文件与 Python 控制台版互通</Description>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- 密码哈希：Argon2id（与 Python argon2-cffi 的 PHC 字符串格式互通） -->
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <!-- Cookie 注入 / 采集：Playwright（与 Python 版同一套 Chromium 行为） -->
    <PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
    <!-- 浏览器进程树监控 / 残留进程查杀（等价于 Python 版的 psutil 用法） -->
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>

</Project>
