<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- 配色：浅色、低饱和，保证长时间阅读舒适 -->
  <SolidColorBrush x:Key="Brush.Page" Color="#F6F7F9" />
  <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#FAFBFC" />
  <SolidColorBrush x:Key="Brush.Border" Color="#E4E7EC" />
  <SolidColorBrush x:Key="Brush.BorderStrong" Color="#D0D5DD" />
  <SolidColorBrush x:Key="Brush.Hover" Color="#F2F4F7" />
  <SolidColorBrush x:Key="Brush.Text" Color="#1D2939" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="#667085" />
  <SolidColorBrush x:Key="Brush.TextMuted" Color="#98A2B3" />
  <SolidColorBrush x:Key="Brush.Accent" Color="#2563EB" />
  <SolidColorBrush x:Key="Brush.AccentHover" Color="#1D4ED8" />
  <SolidColorBrush x:Key="Brush.AccentPressed" Color="#1E40AF" />
  <SolidColorBrush x:Key="Brush.AccentSoft" Color="#EFF4FF" />
  <SolidColorBrush x:Key="Brush.AccentDisabled" Color="#B9C6DE" />
  <SolidColorBrush x:Key="Brush.Danger" Color="#B42318" />
  <SolidColorBrush x:Key="Brush.DangerHover" Color="#FEF3F2" />
  <SolidColorBrush x:Key="Brush.DangerBorder" Color="#FECDCA" />
  <SolidColorBrush x:Key="Brush.Success" Color="#067647" />
  <SolidColorBrush x:Key="Brush.WarningBg" Color="#FFFAEB" />
  <SolidColorBrush x:Key="Brush.WarningBorder" Color="#FEDF89" />
  <SolidColorBrush x:Key="Brush.WarningText" Color="#B54708" />
  <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#C9CFD8" />
  <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="#AAB2BD" />

  <!-- 字体 -->
  <FontFamily x:Key="Font.UI">Microsoft YaHei UI, Segoe UI, Segoe UI Symbol</FontFamily>
  <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>

  <Style x:Key="AppWindow" TargetType="{x:Type Window}">
    <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="Background" Value="{StaticResource Brush.Page}" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <!-- 注意：WindowStartupLocation 不是依赖属性，不能在 Style 中设置，需在各窗口上单独指定 -->
  </Style>

  <!-- 文本 -->
  <Style x:Key="PageTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="19" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
  </Style>

  <Style x:Key="PageSubtitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
  </Style>

  <Style x:Key="Muted" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="Secondary" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
  </Style>

  <Style x:Key="FieldLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>

  <!-- 按钮模板 -->
  <ControlTemplate x:Key="ButtonTemplate" TargetType="Button">
    <Border x:Name="Bd"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="6"
            Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        RecognizesAccessKey="True" />
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
        <Setter Property="Cursor" Value="Arrow" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="PrimaryButton" TargetType="Button">
    <Setter Property="Template" Value="{StaticResource ButtonTemplate}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="16,7" />
    <Setter Property="MinWidth" Value="80" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.AccentHover}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.AccentPressed}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="SecondaryButton" TargetType="Button">
    <Setter Property="Template" Value="{StaticResource ButtonTemplate}" />
    <Setter Property="Foreground" Value="#344054" />
    <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="MinWidth" Value="76" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceAlt}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.Hover}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
    <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.DangerBorder}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.DangerHover}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="GhostButton" TargetType="Button">
    <Setter Property="Template" Value="{StaticResource ButtonTemplate}" />
    <Setter Property="Foreground" Value="#475467" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Cursor" Value="Hand" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.Hover}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="LinkButton" TargetType="Button">
    <Setter Property="Template" Value="{StaticResource ButtonTemplate}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="2,2" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{StaticResource Brush.AccentHover}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- 输入框模板（单行） -->
  <ControlTemplate x:Key="InputTextBoxTemplate" TargetType="TextBox">
    <Border x:Name="Bd"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="6">
      <ScrollViewer x:Name="PART_ContentHost"
                    Margin="{TemplateBinding Padding}"
                    VerticalAlignment="Center"
                    Focusable="False"
                    HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollBarVisibility="Hidden" />
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.TextMuted}" />
      </Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="Input" TargetType="TextBox">
    <Setter Property="Template" Value="{StaticResource InputTextBoxTemplate}" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="CaretBrush" Value="{StaticResource Brush.Text}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- 输入框模板（多行） -->
  <ControlTemplate x:Key="InputAreaTemplate" TargetType="TextBox">
    <Border x:Name="Bd"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="6">
      <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False" />
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.TextMuted}" />
      </Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="InputArea" TargetType="TextBox" BasedOn="{StaticResource Input}">
    <Setter Property="Template" Value="{StaticResource InputAreaTemplate}" />
    <Setter Property="Height" Value="Auto" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
  </Style>

  <Style x:Key="ReadOnlyCode" TargetType="TextBox" BasedOn="{StaticResource InputArea}">
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="{StaticResource Brush.SurfaceAlt}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- 密码框 -->
  <ControlTemplate x:Key="InputPasswordTemplate" TargetType="PasswordBox">
    <Border x:Name="Bd"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="6">
      <ScrollViewer x:Name="PART_ContentHost"
                    Margin="{TemplateBinding Padding}"
                    VerticalAlignment="Center"
                    Focusable="False"
                    HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollBarVisibility="Hidden" />
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.TextMuted}" />
      </Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="InputPassword" TargetType="PasswordBox">
    <Setter Property="Template" Value="{StaticResource InputPasswordTemplate}" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="CaretBrush" Value="{StaticResource Brush.Text}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- 复选项 / 单选项 -->
  <Style x:Key="AppCheckBox" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- 分段式单选（左/右两块，用于互斥选项） -->
  <Style x:Key="SegmentRadio" TargetType="RadioButton">
    <Setter Property="Foreground" Value="#344054" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Bd"
                  Background="{StaticResource Brush.Surface}"
                  BorderBrush="{StaticResource Brush.BorderStrong}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="12,7">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.SurfaceAlt}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentSoft}" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 卡片 -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="18" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="Notice" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.WarningBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.WarningBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,11" />
  </Style>

  <!-- 可选中列表项（网站行） -->
  <Style x:Key="SiteListBoxItem" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,6" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd"
                  Background="{StaticResource Brush.Surface}"
                  BorderBrush="{StaticResource Brush.Border}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="14,11"
                  SnapsToDevicePixels="True">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="#B2C7F0" />
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.SurfaceAlt}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentSoft}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 细滚动条 -->
  <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Rectangle Fill="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Bd" Background="{StaticResource Brush.ScrollThumb}" CornerRadius="3" Margin="2" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.ScrollThumbHover}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type ScrollBar}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="10" />
    <Setter Property="MinWidth" Value="10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ScrollBar}">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageUpCommand" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource ScrollThumb}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageDownCommand" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="10" />
        <Setter Property="MinHeight" Value="10" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ScrollBar}">
              <Grid Background="Transparent">
                <Track x:Name="PART_Track" Orientation="Horizontal">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageLeftCommand" />
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollThumb}" />
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageRightCommand" />
                  </Track.IncreaseRepeatButton>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- 列表容器：去掉默认边框与背景 -->
  <Style x:Key="PlainListBox" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
  </Style>
  <!-- 侧栏导航项 -->
  <Style x:Key="NavListBoxItem" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid>
            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="12,9">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <Border x:Name="Bar"
                    Width="3"
                    Margin="1,8"
                    HorizontalAlignment="Left"
                    CornerRadius="2"
                    Background="Transparent" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentSoft}" />
              <Setter TargetName="Bar" Property="Background" Value="{StaticResource Brush.Accent}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
