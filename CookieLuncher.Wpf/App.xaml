<Application x:Class="CookieLuncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CookieLuncher.Views"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
      <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
