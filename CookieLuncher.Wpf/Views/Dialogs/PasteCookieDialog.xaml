<Window x:Class="CookieLuncher.Views.Dialogs.PasteCookieDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="粘贴导入 Cookie"
        Width="560"
        Height="520"
        MinWidth="480"
        MinHeight="440"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}">
  <Grid Margin="26,22,26,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="粘贴导入 Cookie" FontSize="15" FontWeight="SemiBold" />
    <TextBlock Grid.Row="1"
               Style="{StaticResource Secondary}"
               Margin="0,8,0,0"
               Text="支持分号格式、标准 JSON 数组、Cookie-Editor 导出的 JSON。粘贴内容只用于本机加密保存。" />

    <StackPanel Grid.Row="2" Margin="0,16,0,0">
      <TextBlock Style="{StaticResource FieldLabel}" Text="网站域名（可粘贴链接，自动识别）" />
      <TextBox x:Name="SiteInput" Style="{StaticResource Input}" />
    </StackPanel>

    <Grid Grid.Row="3" Margin="0,14,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Cookie 文本" />
      <TextBox x:Name="CookieInput"
               Grid.Row="1"
               Style="{StaticResource InputArea}"
               AcceptsReturn="True"
               FontFamily="{StaticResource Font.Mono}"
               FontSize="12"
               VerticalScrollBarVisibility="Auto"
               TextChanged="OnCookieTextChanged" />
    </Grid>

    <TextBlock Grid.Row="4"
               x:Name="PreviewText"
               Margin="0,10,0,0"
               FontSize="12"
               TextWrapping="Wrap"
               Foreground="{StaticResource Brush.TextSecondary}" />

    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Style="{StaticResource SecondaryButton}"
              Content="取消"
              Margin="0,0,8,0"
              IsCancel="True"
              Click="OnCancelClick" />
      <Button Style="{StaticResource PrimaryButton}"
              Content="导入"
              IsDefault="True"
              Click="OnImportClick" />
    </StackPanel>
  </Grid>
</Window>
