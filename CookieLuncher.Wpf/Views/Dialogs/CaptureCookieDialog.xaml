<Window x:Class="CookieLuncher.Views.Dialogs.CaptureCookieDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="浏览器登录采集"
        Width="540"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}">
  <StackPanel Margin="26,24,26,20">
    <TextBlock Text="浏览器手动登录并采集 Cookie" FontSize="15" FontWeight="SemiBold" />
    <TextBlock Style="{StaticResource Secondary}"
               Margin="0,8,0,0"
               Text="程序会打开一个可见浏览器窗口，请在浏览器中完成登录（含验证码），然后回到本窗口点击【完成采集】。"
               TextWrapping="Wrap" />

    <Border Style="{StaticResource Notice}" Margin="0,14,0,0">
      <TextBlock FontSize="12"
                 TextWrapping="Wrap"
                 Foreground="{StaticResource Brush.WarningText}"
                 Text="安全提示：Cookie 属于身份凭证。采集结果将加密保存到本机 cookies.enc，请妥善保管密码，不要向他人泄露 Cookie 内容。" />
    </Border>

    <StackPanel Margin="0,16,0,0">
      <TextBlock Style="{StaticResource FieldLabel}" Text="登录 URL" />
      <TextBox x:Name="UrlInput" Style="{StaticResource Input}" />
    </StackPanel>

    <StackPanel Margin="0,14,0,0">
      <TextBlock Style="{StaticResource FieldLabel}" Text="保存到哪个网站域名（默认从 URL 自动识别，可修改）" />
      <TextBox x:Name="SiteInput" Style="{StaticResource Input}" />
    </StackPanel>

    <TextBlock x:Name="StatusText"
               Margin="0,12,0,0"
               FontSize="12"
               TextWrapping="Wrap"
               Foreground="{StaticResource Brush.TextSecondary}" />

    <TextBlock x:Name="ErrorText"
               Margin="0,8,0,0"
               FontSize="12"
               TextWrapping="Wrap"
               Visibility="Collapsed"
               Foreground="{StaticResource Brush.Danger}" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button x:Name="CancelButton"
              Style="{StaticResource SecondaryButton}"
              Content="取消采集"
              Margin="0,0,8,0"
              Click="OnCancelClick" />
      <Button x:Name="StartButton"
              Style="{StaticResource PrimaryButton}"
              Content="开始采集"
              IsDefault="True"
              Click="OnStartClick" />
      <Button x:Name="FinishButton"
              Style="{StaticResource PrimaryButton}"
              Content="完成采集"
              Visibility="Collapsed"
              Click="OnFinishClick" />
    </StackPanel>
  </StackPanel>
</Window>
