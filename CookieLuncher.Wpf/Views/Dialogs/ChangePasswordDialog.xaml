<Window x:Class="CookieLuncher.Views.Dialogs.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修改访问密码"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}">
  <StackPanel Margin="26,24,26,20">
    <TextBlock Text="修改访问密码" FontSize="15" FontWeight="SemiBold" />
    <TextBlock Style="{StaticResource Secondary}"
               Margin="0,8,0,0"
               Text="修改后会用新密钥重新加密 cookies.enc。请注意：修改密码后必须重新导出 GitHub Action 配置，并同步更新 Secret 与仓库文件。"
               TextWrapping="Wrap" />

    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,18,0,6" Text="当前密码" />
    <PasswordBox x:Name="OldInput" Style="{StaticResource InputPassword}" PasswordChanged="OnInputChanged" />

    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,6" Text="新密码（至少 6 位）" />
    <PasswordBox x:Name="NewInput" Style="{StaticResource InputPassword}" PasswordChanged="OnInputChanged" />

    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,6" Text="再次输入新密码" />
    <PasswordBox x:Name="ConfirmInput" Style="{StaticResource InputPassword}" PasswordChanged="OnInputChanged" />

    <TextBlock x:Name="ErrorText"
               Margin="0,12,0,0"
               FontSize="12"
               TextWrapping="Wrap"
               Visibility="Collapsed"
               Foreground="{StaticResource Brush.Danger}" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
      <Button Style="{StaticResource SecondaryButton}"
              Content="取消"
              Margin="0,0,8,0"
              IsCancel="True"
              Click="OnCancelClick" />
      <Button Style="{StaticResource PrimaryButton}"
              Content="修改密码"
              IsDefault="True"
              Click="OnConfirmClick" />
    </StackPanel>
  </StackPanel>
</Window>
