<Window x:Class="CookieLuncher.Views.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="500"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}">
  <StackPanel Margin="26,24,26,20">
    <TextBlock Text="设置" FontSize="15" FontWeight="SemiBold" />

    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,18,0,6" Text="浏览器后端" />
    <StackPanel Orientation="Horizontal">
      <RadioButton x:Name="ThoriumRadio"
                   Style="{StaticResource SegmentRadio}"
                   GroupName="Backend"
                   Content="内置 Thorium（离线自包含）" />
      <RadioButton x:Name="SystemRadio"
                   Style="{StaticResource SegmentRadio}"
                   GroupName="Backend"
                   Margin="8,0,0,0"
                   Content="本机 Edge / Chrome" />
    </StackPanel>

    <Grid Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="180" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Style="{StaticResource FieldLabel}" Text="窗口尺寸" />
        <TextBox x:Name="WindowSizeInput" Style="{StaticResource Input}" />
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Style="{StaticResource FieldLabel}" Text="日志级别" />
        <ComboBox x:Name="LogLevelInput" Height="34" VerticalContentAlignment="Center" />
      </StackPanel>
    </Grid>
    <TextBlock Style="{StaticResource Muted}"
               Margin="0,8,0,0"
               Text="窗口尺寸填写 maximized 或 1280x720 形式。" />

    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,6" Text="日志保留天数" />
    <TextBox x:Name="RetentionInput" Style="{StaticResource Input}" Width="180" HorizontalAlignment="Left" />

    <CheckBox x:Name="HeadlessInput"
              Style="{StaticResource AppCheckBox}"
              Margin="0,18,0,0"
              Content="无头模式启动浏览器（无窗口，5 秒后自动关闭）" />

    <TextBlock x:Name="ErrorText"
               Margin="0,12,0,0"
               FontSize="12"
               TextWrapping="Wrap"
               Visibility="Collapsed"
               Foreground="{StaticResource Brush.Danger}" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
      <Button Style="{StaticResource SecondaryButton}"
              Content="取消"
              Margin="0,0,8,0"
              IsCancel="True"
              Click="OnCancelClick" />
      <Button Style="{StaticResource PrimaryButton}"
              Content="保存"
              IsDefault="True"
              Click="OnSaveClick" />
    </StackPanel>
  </StackPanel>
</Window>
